# Copy this file to `.env.local` and fill in your credentials.

# --- LiveKit Cloud (free "Build" plan) — covers STT & TTS via Inference ---
# https://cloud.livekit.io -> your project -> Settings -> Keys
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET

# --- Google Cloud (Vertex AI) — for the Gemini LLM (region-local, low latency) ---
# Path to a service-account JSON key with Vertex AI access (keep it OUT of git).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=asia-south1
